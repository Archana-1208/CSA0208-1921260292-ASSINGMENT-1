#include <stdio.h>

long long calls = 0;

/* Digital Root */
int digital_root(int n)
{
    if (n < 10)
        return n;

    int sum = 0;

    while (n > 0)
    {
        sum += n % 10;
        n /= 10;
    }

    return digital_root(sum);
}

/* Linear Power */
long long power_linear(long long base, int exp)
{
    calls++;

    if (exp == 0)
        return 1;

    return base * power_linear(base, exp - 1);
}

/* Fast Power */
long long power_fast(long long base, int exp)
{
    calls++;

    if (exp == 0)
        return 1;

    long long half = power_fast(base, exp / 2);

    if (exp % 2 == 0)
        return half * half;

    return base * half * half;
}

int main()
{
    printf("Digital Root of 5832 = %d\n",
           digital_root(5832));

    calls = 0;

    printf("\nLinear Power = %lld\n",
           power_linear(2, 10));

    printf("Linear Calls = %lld\n", calls);

    calls = 0;

    printf("\nFast Power = %lld\n",
           power_fast(2, 10));

    printf("Fast Calls = %lld\n", calls);

    calls = 0;

    power_linear(2, 30);
    printf("\nLinear Calls for n=30: %lld\n", calls);

    calls = 0;

    power_fast(2, 30);
    printf("Fast Calls for n=30: %lld\n", calls);

    return 0;
}